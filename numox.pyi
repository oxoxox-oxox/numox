from typing import List, Sequence, Tuple, Union, overload

_Number = Union[int, float]
_Index1D = Union[int, slice]
_Index2D = Tuple[_Index1D, _Index1D]

class Matrix:
    @overload
    def __init__(self, rows: int, cols: int, *, rand: bool, low: _Number = 0.0, high: _Number = 1.0, seed: int = 0) -> None: ...
    @overload
    def __init__(self, rows: int, cols: int, val: _Number = 0.0) -> None: ...
    @overload
    def __init__(self, rows: int, cols: int, data: List[_Number]) -> None: ...
    @overload
    def __init__(self, data: List[List[_Number]]) -> None: ...

    @property
    def shape(self) -> Union[Tuple[int], Tuple[int, int]]: ...

    def get(self, row: int, col: int) -> float: ...
    def set(self, row: int, col: int, value: _Number) -> None: ...
    def to_list(self) -> Union[List[float], List[List[float]]]: ...

    def __repr__(self) -> str: ...
    def __add__(self, other: 'Matrix') -> 'Matrix': ...
    def __sub__(self, other: 'Matrix') -> 'Matrix': ...
    def __mul__(self, other: 'Matrix') -> 'Matrix': ...
    def __matmul__(self, other: 'Matrix') -> 'Matrix': ...
    def __neg__(self) -> 'Matrix': ...
    def __abs__(self) -> 'Matrix': ...
    def __pow__(self, exponent: int) -> 'Matrix': ...

    @overload
    def __getitem__(self, key: int) -> Union[float, 'Matrix']: ...
    @overload
    def __getitem__(self, key: slice) -> 'Matrix': ...
    @overload
    def __getitem__(self, key: _Index2D) -> Union[float, 'Matrix']: ...

    def __setitem__(
        self,
        key: Union[int, slice, _Index2D],
        value: Union[_Number, Sequence[_Number], Sequence[Sequence[_Number]]],
    ) -> None: ...

def to_list(mat: Matrix) -> Union[List[float], List[List[float]]]: ...
